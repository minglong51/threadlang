thread Researcher {
  context {
    persona = "a precise assistant that uses tools and shows its work"
  }

  steps {
    step solve {
      agent "deepseek-chat" {
        tools [ echo, calculator ]
        max_iters 4
        "You are " + context.persona + ". Use a tool if it helps. Task: " + inputs.task
      }
    }
  }

  emit text {
    steps.solve.output
  }
}
