(* ThreadLang grammar (v0.11 — adds expect output contracts on llm steps) *)

program        = "thread", ws, identifier, ws, "{", ws,
                 context_block,
                 [ ws, steps_block ],
                 ws, emit_block,
                 ws, "}" ;

context_block  = "context", ws, "{", ws, assignment, { ws, assignment }, ws, "}" ;
assignment     = identifier, ws, "=", ws, string_literal ;

steps_block    = "steps", ws, "{", ws, step, { ws, step }, ws, "}" ;
step           = "step", ws, identifier, ws, "{", ws,
                 ( llm_body | agent_body | route_body ), ws, "}" ;
llm_body       = "llm", ws, string_literal, ws, "{", ws, expression,
                 [ ws, expect_block ], [ ws, then_decl ], ws, "}" ;
expect_block   = "expect", ws, "{", ws, expect_rule, { ws, expect_rule }, ws, "}" ;
expect_rule    = "one_of", ws, string_literal, { ws, ",", ws, string_literal }
               | "matches", ws, string_literal
               | "max_chars", ws, integer
               | "nonempty" ;
agent_body     = "agent", ws, string_literal, ws, "{", ws,
                 [ tools_decl, ws ], [ max_iters_decl, ws ], expression,
                 [ ws, then_decl ], ws, "}" ;
route_body     = "route", ws, string_literal, ws, "{", ws, expression,
                 ws, arm, { ws, arm }, [ ws, else_decl ], ws, "}" ;
arm            = "on", ws, string_literal, ws, "->", ws, target ;
else_decl      = "else", ws, "->", ws, target ;
then_decl      = "then", ws, "->", ws, target ;

(* Targets are forward-only: a target step must be declared after the step
   that jumps to it. "end" is reserved (skip to emit) and is not a valid
   step name. *)
target         = identifier | "end" ;

tools_decl     = "tools", ws, "[", ws,
                 [ identifier, { ws, ",", ws, identifier } ], ws, "]" ;
max_iters_decl = "max_iters", ws, integer ;
integer        = digit, { digit } ;

emit_block     = emit_text | emit_llm ;
emit_text      = "emit", ws, "text", ws, "{", ws, expression, ws, "}" ;
emit_llm       = "emit", ws, "llm", ws, string_literal, ws, "{", ws, expression, ws, "}" ;

expression     = term, { ws, "+", ws, term } ;
term           = string_literal | context_ref | inputs_ref | steps_ref ;

context_ref    = "context", ".", identifier ;
inputs_ref     = "inputs", ".", identifier ;
steps_ref      = "steps", ".", identifier, ".", "output", [ "?" ] ;

identifier     = letter, { letter | digit | "_" } ;
string_literal = '"', { character - '"' }, '"' ;

ws             = { " " | "\t" | "\n" | "\r" } ;
