(* ThreadLang v1 grammar *)

program        = "thread", ws, identifier, ws, "{", ws,
                 context_block,
                 [ ws, steps_block ],
                 ws, emit_block,
                 ws, "}" ;

context_block  = "context", ws, "{", ws, assignment, { ws, assignment }, ws, "}" ;
assignment     = identifier, ws, "=", ws, string_literal ;

steps_block    = "steps", ws, "{", ws, step, { ws, step }, ws, "}" ;
step           = "step", ws, identifier, ws, "{", ws,
                 "llm", ws, string_literal, ws, "{", ws, expression, ws, "}",
                 ws, "}" ;

emit_block     = emit_text | emit_llm ;
emit_text      = "emit", ws, "text", ws, "{", ws, expression, ws, "}" ;
emit_llm       = "emit", ws, "llm", ws, string_literal, ws, "{", ws, expression, ws, "}" ;

expression     = term, { ws, "+", ws, term } ;
term           = string_literal | context_ref | inputs_ref | steps_ref ;

context_ref    = "context", ".", identifier ;
inputs_ref     = "inputs", ".", identifier ;
steps_ref      = "steps", ".", identifier, ".", "output" ;

identifier     = letter, { letter | digit | "_" } ;
string_literal = '"', { character - '"' }, '"' ;

ws             = { " " | "\t" | "\n" | "\r" } ;
